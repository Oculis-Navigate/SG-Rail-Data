#!/bin/sh
set -eu
# Git provides all refs being pushed. Inspect committed trees, not unstaged files.
needs_checks=false
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in *[!0]*) ;; *) continue ;; esac  # deletion
    case "$remote_oid" in
        *[!0]*) base=$remote_oid ;;
        *) base=$(git merge-base "$local_oid" refs/remotes/origin/main || git hash-object -w -t tree /dev/null) ;;
    esac
    scope=$(sh .githooks/change-scope "$base" "$local_oid")
    [ "$scope" = regular ] || needs_checks=true
done
[ "$needs_checks" = true ] || exit 0
uv run --frozen sg-rail-station-data config validate
uv run --frozen sg-rail-station-data audit validate
uv run --frozen python -m unittest discover -s tests -q
